package com.example.addon.modules;

import com.example.addon.AddonTemplate;
import meteordevelopment.meteorclient.events.world.TickEvent;
import meteordevelopment.meteorclient.systems.modules.Module;
import meteordevelopment.orbit.EventHandler;

public class GrimSprint extends Module {

    public GrimSprint() {
        super(AddonTemplate.ANARCHY_CATEGORY, "GrimSprint", "Omni-directional Auto Sprint.");
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (mc.player == null || mc.world == null) return;

        // Chỉ kích hoạt khi người chơi có di chuyển và không bị mù/mệt mỏi
        if (mc.player.forwardSpeed != 0 || mc.player.sidewaysSpeed != 0) {
            if (!mc.player.isSneaking() && !mc.player.horizontalCollision) {
                mc.player.setSprinting(true);
            }
        }
    }
}
