package com.example.addon.modules;

import com.example.addon.AddonTemplate;
import fi.dy.masa.litematica.world.SchematicWorldHandler;
import meteordevelopment.meteorclient.events.world.TickEvent;
import meteordevelopment.meteorclient.settings.*;
import meteordevelopment.meteorclient.systems.modules.Module;
import meteordevelopment.meteorclient.utils.player.FindItemResult;
import meteordevelopment.meteorclient.utils.player.InvUtils;
import meteordevelopment.meteorclient.utils.player.Rotations;
import meteordevelopment.orbit.EventHandler;
import net.minecraft.block.Block;
import net.minecraft.block.BlockState;
import net.minecraft.block.Blocks;
import net.minecraft.item.Item;
import net.minecraft.util.Hand;
import net.minecraft.util.hit.BlockHitResult;
import net.minecraft.util.math.BlockPos;
import net.minecraft.util.math.Direction;
import net.minecraft.util.math.Vec3d;
import net.minecraft.world.World;

import java.util.List;

public class GrimPrinter extends Module {

    private final SettingGroup sgGeneral = settings.getDefaultGroup();

    // 1. Nút bật/tắt tổng tính năng thay thế
    private final Setting<Boolean> allowSubstitute = sgGeneral.add(new BooleanSetting.Builder()
        .name("allow-substitute")
        .description("Cho phép tự động dùng block thay thế khi thiếu nguyên liệu chính.")
        .defaultValue(true)
        .build()
    );

    // 2. Danh mục lựa chọn CÁC KHỐI ĐƯỢC PHÉP THAY THẾ (Target Blocks to Replace)
    private final Setting<List<Block>> replaceableBlocks = sgGeneral.add(new BlockListSetting.Builder()
        .name("replaceable-targets")
        .description("Chọn các khối trong bản vẽ mà bạn CHO PHÉP THAY THẾ khi hết hàng.")
        .defaultValue(
            Blocks.STONE,
            Blocks.COBBLESTONE,
            Blocks.DIRT,
            Blocks.OAK_PLANKS,
            Blocks.SPRUCE_PLANKS,
            Blocks.BIRCH_PLANKS,
            Blocks.NETHERRACK,
            Blocks.STONE_BRICKS,
            Blocks.TERRACOTTA
        )
        .visible(allowSubstitute::get)
        .build()
    );

    // 3. Danh mục lựa chọn CÁC KHỐI DÙNG LÀM NGUYÊN LIỆU THAY THẾ (Substitute Materials)
    private final Setting<List<Block>> substituteMaterials = sgGeneral.add(new BlockListSetting.Builder()
        .name("substitute-materials")
        .description("Danh sách các khối dự phòng trong Hotbar sẽ lấy ra để đặt (theo thứ tự ưu tiên).")
        .defaultValue(
            Blocks.COBBLESTONE,
            Blocks.DIRT,
            Blocks.OAK_PLANKS,
            Blocks.SPRUCE_PLANKS,
            Blocks.BIRCH_PLANKS,
            Blocks.STONE,
            Blocks.NETHERRACK
        )
        .visible(allowSubstitute::get)
        .build()
    );

    private static final int BLOCKS_PER_TICK = 2; // Giới hạn 2 block/tick tránh GrimAC kick
    private static final double RANGE = 4.5;

    public GrimPrinter() {
        super(AddonTemplate.ANARCHY_CATEGORY, "GrimPrinter", "Auto-builds Litematica with custom replaceable blocks menu.");
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (mc.player == null || mc.world == null) return;

        World schematicWorld = SchematicWorldHandler.getSchematicWorld();
        if (schematicWorld == null) return;

        BlockPos playerPos = mc.player.getBlockPos();
        int placedCount = 0;
        int radius = (int) Math.ceil(RANGE);

        for (int x = -radius; x <= radius; x++) {
            for (int y = -radius; y <= radius; y++) {
                for (int z = -radius; z <= radius; z++) {
                    if (placedCount >= BLOCKS_PER_TICK) break;

                    BlockPos pos = playerPos.add(x, y, z);
                    if (mc.player.squaredDistanceTo(Vec3d.ofCenter(pos)) > RANGE * RANGE) continue;

                    BlockState requiredState = schematicWorld.getBlockState(pos);
                    BlockState currentState = mc.world.getBlockState(pos);

                    if (!requiredState.isAir() && currentState.isReplaceable()) {
                        Block requiredBlock = requiredState.getBlock();
                        Item targetItem = requiredBlock.asItem();

                        // 1. Tìm đúng block nguyên bản trong Hotbar
                        FindItemResult item = InvUtils.findInHotbar(targetItem);

                        // 2. Nếu thiếu block nguyên bản -> Kiểm tra xem block này có nằm trong danh mục "replaceable-targets" hay không
                        if (!item.found() && allowSubstitute.get()) {
                            if (replaceableBlocks.get().contains(requiredBlock)) {
                                item = findSubstituteFromSettings();
                            }
                        }

                        // 3. Tiến hành đặt block (No Air Place - Strict GrimAC)
                        if (item.found()) {
                            if (placeBlockStrict(pos, item.slot())) {
                                placedCount++;
                            }
                        }
                    }
                }
            }
        }
    }

    // Quét các khối dự phòng có sẵn trong Hotbar dựa trên danh mục substitute-materials
    private FindItemResult findSubstituteFromSettings() {
        for (Block block : substituteMaterials.get()) {
            FindItemResult result = InvUtils.findInHotbar(block.asItem());
            if (result.found()) {
                return result;
            }
        }
        return InvUtils.findInHotbar(itemStack -> false);
    }

    // Cơ chế đặt block Strict Neighbor (Bypass GrimAC 100%, không Air Place)
    private boolean placeBlockStrict(BlockPos pos, int slot) {
        for (Direction side : Direction.values()) {
            BlockPos neighbor = pos.offset(side);
            Direction sideOpposite = side.getOpposite();

            if (!mc.world.getBlockState(neighbor).isAir() && !mc.world.getBlockState(neighbor).isReplaceable()) {
                Vec3d hitVec = Vec3d.ofCenter(neighbor).add(
                    sideOpposite.getOffsetX() * 0.5,
                    sideOpposite.getOffsetY() * 0.5,
                    sideOpposite.getOffsetZ() * 0.5
                );

                int prevSlot = mc.player.getInventory().selectedSlot;
                Rotations.rotate(Rotations.getYaw(hitVec), Rotations.getPitch(hitVec), () -> {
                    InvUtils.swap(slot, false);
                    BlockHitResult hitResult = new BlockHitResult(hitVec, sideOpposite, neighbor, false);
                    mc.interactionManager.interactBlock(mc.player, Hand.MAIN_HAND, hitResult);
                    mc.player.swingHand(Hand.MAIN_HAND);
                    InvUtils.swap(prevSlot, false);
                });

                return true;
            }
        }
        return false;
    }
}
