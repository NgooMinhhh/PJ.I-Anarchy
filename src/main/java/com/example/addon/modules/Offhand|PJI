package com.example.addon.modules;

import com.example.addon.AddonTemplate;
import meteordevelopment.meteorclient.events.world.TickEvent;
import meteordevelopment.meteorclient.systems.modules.Module;
import meteordevelopment.meteorclient.utils.player.FindItemResult;
import meteordevelopment.meteorclient.utils.player.InvUtils;
import meteordevelopment.orbit.EventHandler;
import net.minecraft.entity.decoration.EndCrystalEntity;
import net.minecraft.item.Item;
import net.minecraft.item.Items;

public class GrimOffhand extends Module {

    public GrimOffhand() {
        super(AddonTemplate.ANARCHY_CATEGORY, "GrimOffhand", "Auto Totem, Crystal and EGap Offhand pre-configured for 2y2c GrimAC.");
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (mc.player == null || mc.world == null) return;

        // Bỏ qua nếu đang mở GUI kho đồ để tránh desync slot
        if (mc.currentScreen != null) return;

        Item targetItem = getItemToHold();

        // Nếu tay phụ chưa cầm đúng item thì tiến hành chuyển item sang offhand
        if (mc.player.getOffHandStack().getItem() != targetItem) {
            FindItemResult result = InvUtils.find(targetItem);
            if (result.found()) {
                InvUtils.move().from(result.slot()).toOffhand();
            }
        }
    }

    private Item getItemToHold() {
        float totalHealth = mc.player.getHealth() + mc.player.getAbsorptionAmount();

        // 1. Máu thấp (<= 10 HP) -> Bắt buộc giữ Totem
        if (totalHealth <= 10.0f) {
            FindItemResult totem = InvUtils.find(Items.TOTEM_OF_UNDYING);
            if (totem.found()) return Items.TOTEM_OF_UNDYING;
        }

        // 2. Có Crystal gần chực nổ (<= 6m) -> Bắt buộc giữ Totem
        for (net.minecraft.entity.Entity entity : mc.world.getEntities()) {
            if (entity instanceof EndCrystalEntity && mc.player.distanceTo(entity) <= 6.0f) {
                FindItemResult totem = InvUtils.find(Items.TOTEM_OF_UNDYING);
                if (totem.found()) return Items.TOTEM_OF_UNDYING;
            }
        }

        // 3. Khi đang giữ chuột phải (đang ăn/sử dụng item) -> Đổi sang Enchanted Golden Apple
        if (mc.options.useKey.isPressed()) {
            FindItemResult egap = InvUtils.find(Items.ENCHANTED_GOLDEN_APPLE);
            if (egap.found()) return Items.ENCHANTED_GOLDEN_APPLE;
        }

        // 4. Trạng thái bình thường khi an toàn -> Ưu tiên cầm End Crystal trên tay phụ
        FindItemResult crystal = InvUtils.find(Items.END_CRYSTAL);
        if (crystal.found()) {
            return Items.END_CRYSTAL;
        }

        // Nếu hết Crystal thì cầm EGap dự phòng
        FindItemResult egap = InvUtils.find(Items.ENCHANTED_GOLDEN_APPLE);
        if (egap.found()) {
            return Items.ENCHANTED_GOLDEN_APPLE;
        }

        return Items.TOTEM_OF_UNDYING;
    }
}
