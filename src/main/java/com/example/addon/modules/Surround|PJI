package com.example.addon.modules;

import com.example.addon.AddonTemplate;
import meteordevelopment.meteorclient.events.world.TickEvent;
import meteordevelopment.meteorclient.settings.*;
import meteordevelopment.meteorclient.systems.modules.Module;
import meteordevelopment.meteorclient.utils.player.FindItemResult;
import meteordevelopment.meteorclient.utils.player.InvUtils;
import meteordevelopment.meteorclient.utils.player.Rotations;
import meteordevelopment.orbit.EventHandler;
import net.minecraft.item.Items;
import net.minecraft.util.Hand;
import net.minecraft.util.hit.BlockHitResult;
import net.minecraft.util.math.BlockPos;
import net.minecraft.util.math.Box;
import net.minecraft.util.math.Direction;
import net.minecraft.util.math.Vec3d;

import java.util.ArrayList;
import java.util.List;

public class GrimSurround extends Module {
    private final SettingGroup sgGeneral = settings.getDefaultGroup();
    private final SettingGroup sgGrim = settings.createGroup("GrimAC / 2y2c Bypass");

    // General Settings
    private final Setting<Integer> height = sgGeneral.add(new IntSetting.Builder()
            .name("height")
            .description("Độ cao của tường Obsidian bao quanh (1 = ngang chân, 2 = ngang đầu).")
            .defaultValue(1)
            .min(1)
            .sliderMax(3)
            .build());

    private final Setting<Boolean> disableOnJump = sgGeneral.add(new BoolSetting.Builder()
            .name("disable-on-jump")
            .description("Tự tắt module khi nhảy lên.")
            .defaultValue(true)
            .build());

    // GrimAC Bypass Settings
    private final Setting<Integer> blocksPerTick = sgGrim.add(new IntSetting.Builder()
            .name("blocks-per-tick")
            .description("Số block đặt tối đa trong 1 tick để tránh bị GrimAC hủy block (Khuyên dùng: 2 - 3).")
            .defaultValue(2)
            .min(1)
            .sliderMax(5)
            .build());

    private final Setting<Integer> placeDelay = sgGrim.add(new IntSetting.Builder()
            .name("place-delay-ticks")
            .description("Độ trễ giữa các lần đặt (tính bằng tick). 0 = đặt liên tục mỗi tick.")
            .defaultValue(0)
            .min(0)
            .sliderMax(5)
            .build());

    private final Setting<Boolean> silentRotation = sgGrim.add(new BoolSetting.Builder()
            .name("silent-rotation")
            .description("Xoay góc nhìn Server-side để GrimAC nhận diện vị trí tương tác chuẩn.")
            .defaultValue(true)
            .build());

    private int timer = 0;

    public GrimSurround() {
        super(AddonTemplate.ANARCHY_CATEGORY, "GrimSurround", "Surround 2x2 thông minh kiểm soát tốc độ đặt né GrimAC 2y2c.");
    }

    @Override
    public void onActivate() {
        timer = 0;
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (mc.player == null || mc.world == null) return;

        // Tự tắt khi nhảy hoặc rơi tự do
        if (disableOnJump.get() && (mc.options.jumpKey.isPressed() || mc.player.fallDistance > 0.5)) {
            toggle();
            return;
        }

        // Xử lý Cooldown giữa các lần đặt
        if (timer > 0) {
            timer--;
            return;
        }

        FindItemResult obsidian = InvUtils.findInHotbar(Items.OBSIDIAN);
        if (!obsidian.found()) return;

        List<BlockPos> targetPositions = getDynamicSurroundPositions();
        int placedCount = 0;

        for (BlockPos pos : targetPositions) {
            if (mc.world.getBlockState(pos).isReplaceable()) {
                int prevSlot = mc.player.getInventory().selectedSlot;

                InvUtils.swap(obsidian.slot(), false);
                placeBlock(pos);
                InvUtils.swap(prevSlot, false);

                placedCount++;

                // Giới hạn số block đặt trong 1 tick để né GrimAC
                if (placedCount >= blocksPerTick.get()) {
                    timer = placeDelay.get();
                    break;
                }
            }
        }
    }

    private List<BlockPos> getDynamicSurroundPositions() {
        List<BlockPos> positions = new ArrayList<>();
        Box bb = mc.player.getBoundingBox();

        int minX = (int) Math.floor(bb.minX);
        int maxX = (int) Math.floor(bb.maxX);
        int minZ = (int) Math.floor(bb.minZ);
        int maxZ = (int) Math.floor(bb.maxZ);
        int minY = (int) Math.floor(bb.minY);

        // 1. Đặt sàn dưới chân (tự động nở rộng 2x2 nếu đứng đè ranh giới)
        for (int x = minX; x <= maxX; x++) {
            for (int z = minZ; z <= maxZ; z++) {
                positions.add(new BlockPos(x, minY - 1, z));
            }
        }

        // 2. Đặt tường vây xung quanh theo chiều cao
        for (int h = 0; h < height.get(); h++) {
            int currentY = minY + h;

            for (int x = minX - 1; x <= maxX + 1; x++) {
                for (int z = minZ - 1; z <= maxZ + 1; z++) {
                    if (x >= minX && x <= maxX && z >= minZ && z <= maxZ) continue;
                    positions.add(new BlockPos(x, currentY, z));
                }
            }
        }

        return positions;
    }

    private void placeBlock(BlockPos pos) {
        Vec3d vec = Vec3d.ofCenter(pos);
        Runnable placeTask = () -> {
            BlockHitResult hitResult = new BlockHitResult(vec, Direction.UP, pos, false);
            mc.interactionManager.interactBlock(mc.player, Hand.MAIN_HAND, hitResult);
            mc.player.swingHand(Hand.MAIN_HAND);
        };

        if (silentRotation.get()) {
            Rotations.rotate(Rotations.getYaw(vec), Rotations.getPitch(vec), placeTask);
        } else {
            placeTask.run();
        }
    }
}
